"""Scrapy settings generated by ProtoForge {{ pf_version }} from spec.yaml.

Transport values mirror spec.transport so curl_cffi presents the same browser
fingerprint as the User-Agent. Change spec.yaml and regenerate rather than
editing these by hand.
"""
from {{ name }}.api import TRANSPORT

BOT_NAME = {{ name | tojson }}
SPIDER_MODULES = [{{ (name ~ ".spiders") | tojson }}]
NEWSPIDER_MODULE = {{ (name ~ ".spiders") | tojson }}

ROBOTSTXT_OBEY = {{ "True" if compliance.get("obey_robots", True) else "False" }}
USER_AGENT = TRANSPORT["user_agent"]
DEFAULT_REQUEST_HEADERS = dict(TRANSPORT.get("default_headers") or {})

# politeness: spec.transport.rate_limit / spec.compliance.max_concurrency
_RPS = float((TRANSPORT.get("rate_limit") or {}).get("rps", 1))
DOWNLOAD_DELAY = 1.0 / _RPS
RANDOMIZE_DOWNLOAD_DELAY = bool((TRANSPORT.get("rate_limit") or {}).get("jitter"))
CONCURRENT_REQUESTS = {{ compliance.get("max_concurrency", 1) }}
CONCURRENT_REQUESTS_PER_DOMAIN = {{ compliance.get("max_concurrency", 1) }}
AUTOTHROTTLE_ENABLED = True
AUTOTHROTTLE_START_DELAY = DOWNLOAD_DELAY
AUTOTHROTTLE_TARGET_CONCURRENCY = 1.0
DOWNLOAD_TIMEOUT = int(TRANSPORT.get("timeout", 30))

# curl_cffi transport (TLS/HTTP2 fingerprint) via scrapy-impersonate
DOWNLOAD_HANDLERS = {
    "http": "scrapy_impersonate.ImpersonateDownloadHandler",
    "https": "scrapy_impersonate.ImpersonateDownloadHandler",
}
TWISTED_REACTOR = "twisted.internet.asyncioreactor.AsyncioSelectorReactor"

# Retries are handled in base_spider: every retry rebuilds the request so
# timestamps, nonces and signatures are fresh instead of replayed.
RETRY_ENABLED = False
COOKIES_ENABLED = True
TELNETCONSOLE_ENABLED = False

ITEM_PIPELINES = {"{{ name }}.pipelines.JsonlPipeline": 300}
PF_OUTPUT_DIR = "data"
LOG_LEVEL = "INFO"
