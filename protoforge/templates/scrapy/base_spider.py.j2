"""Shared spider logic generated by ProtoForge {{ pf_version }}.

One spider per operation with items. Flow: dependencies (in order) -> page 1 ->
next pages. Every request, including retries, is rebuilt through api.py so
timestamps, nonces and signatures are always fresh. A business rejection
(HTTP 200 with a failing success rule) closes the spider instead of retrying.
"""
from __future__ import annotations

import json
import os

import scrapy
from scrapy.exceptions import CloseSpider

from {{ name }} import api
from {{ name }} import pf_runtime as rt


def _dep_order(op: str) -> list[str]:
    order: list[str] = []

    def visit(n: str) -> None:
        for d in api.OPS[n]["meta"].get("depends_on", []):
            if d not in order:
                visit(d)
                order.append(d)

    visit(op)
    return order


class ProtoForgeSpider(scrapy.Spider):
    op: str = ""

    def __init__(self, *args, max_pages=None, **kwargs):
        meta = api.OPS[self.op]["meta"]
        self.inputs = {k: kwargs.pop(k) for k in list(kwargs) if k in meta["inputs"]}
        super().__init__(*args, **kwargs)
        pg = meta.get("pagination") or {"mode": "none"}
        self.max_pages = int(max_pages or pg.get("max_pages") or 100)
        self.ctx = api.new_context()
        self.deps = _dep_order(self.op)
        retry = api.TRANSPORT.get("retry") or {}
        self.max_attempts = int(retry.get("max_attempts", 3))
        self.retry_statuses = list(retry.get("statuses", [429, 502, 503, 504]))
        self.idempotent_only = retry.get("idempotent_only", True)
        self.seen_cursors: set[str] = set()
        self.pf_counts = {rt.TRANSPORT_ERROR: 0, rt.REJECTED: 0, rt.ACCEPTED: 0, rt.TARGET_OK: 0}
        self._first = True

    # -- request plumbing -------------------------------------------------
    def _build(self, op: str, cursor=None):
        meta = api.OPS[op]["meta"]
        kwargs = {k: v for k, v in self.inputs.items() if k in meta["inputs"]}
        if (meta.get("pagination") or {}).get("mode", "none") != "none":
            kwargs["cursor"] = cursor
        return api.OPS[op]["build"](self.ctx, **kwargs)

    def _request(self, op: str, step: dict, attempt: int = 1) -> scrapy.Request:
        prepared = self._build(op, step.get("cursor"))
        headers = {k: rt.to_str(v) for k, v in prepared.headers.items()}
        body = prepared.body_bytes()
        if body is not None and prepared.content_type():
            headers.setdefault("Content-Type", prepared.content_type())
        meta = {
            "impersonate": api.TRANSPORT["impersonate"],
            "dont_retry": True,
            "handle_httpstatus_list": self.retry_statuses + [400, 401, 403, 404, 412],
            "pf_op": op,
            "pf_step": step,
            "pf_attempt": attempt,
        }
        proxy_env = api.TRANSPORT.get("proxy_env")
        if proxy_env and os.environ.get(proxy_env):
            meta["proxy"] = os.environ[proxy_env]
        cookies = None
        if self._first:
            self._first = False
            raw = os.environ.get((api.SESSION or {}).get("cookies_env") or "", "")
            cookies = dict(p.strip().split("=", 1) for p in raw.split(";") if "=" in p) or None
        return scrapy.Request(
            prepared.url, method=prepared.method, headers=headers, body=body, cookies=cookies,
            callback=self._on_response, errback=self._on_error, meta=meta, dont_filter=True,
        )

    def _retryable(self, op: str) -> bool:
        return api.OPS[op]["meta"]["method"] in ("GET", "HEAD", "OPTIONS") or not self.idempotent_only

    def _first_step(self):
        if self.deps:
            return self.deps[0], {"kind": "dep", "index": 0}
        return self.op, {"kind": "page", "page": 1, "cursor": rt.first_cursor(api.OPS[self.op]["meta"])}

    async def start(self):  # Scrapy >= 2.13
        for req in self.start_requests():
            yield req

    def start_requests(self):
        op, step = self._first_step()
        yield self._request(op, step)

    # -- responses ---------------------------------------------------------
    def _on_error(self, failure):
        req = failure.request
        op, step, attempt = req.meta["pf_op"], req.meta["pf_step"], req.meta["pf_attempt"]
        self.pf_counts[rt.TRANSPORT_ERROR] += 1
        self.logger.warning("transport error on %s (attempt %s): %s", op, attempt, failure.value)
        if attempt < self.max_attempts and self._retryable(op):
            yield self._request(op, step, attempt + 1)
        else:
            raise CloseSpider("transport_error")

    def _on_response(self, response):
        op, step, attempt = response.meta["pf_op"], response.meta["pf_step"], response.meta["pf_attempt"]
        meta = api.OPS[op]["meta"]
        if response.status in self.retry_statuses:
            self.pf_counts[rt.REJECTED] += 1
            if attempt < self.max_attempts and self._retryable(op):
                self.logger.info("status %s on %s, rebuilding request (attempt %s)", response.status, op, attempt + 1)
                yield self._request(op, step, attempt + 1)
                return
            raise CloseSpider(f"http_{response.status}")
        if response.status >= 400:
            self.pf_counts[rt.REJECTED] += 1
            raise CloseSpider(f"http_{response.status}")
        try:
            payload = json.loads(response.text)
        except ValueError:
            self.pf_counts[rt.REJECTED] += 1
            raise CloseSpider("non_json_response")
        try:
            rt.check_success(op, meta, payload)
        except rt.BusinessError as exc:
            self.pf_counts[rt.REJECTED] += 1
            self.logger.error("business rejection, stopping the batch: %s", exc)
            raise CloseSpider("business_rejected")
        self.pf_counts[rt.TARGET_OK] += 1

        if step["kind"] == "dep":
            self.ctx.upstream[op] = rt.extract(op, meta, payload)
            nxt = step["index"] + 1
            if nxt < len(self.deps):
                yield self._request(self.deps[nxt], {"kind": "dep", "index": nxt})
            else:
                first = rt.first_cursor(api.OPS[self.op]["meta"])
                yield self._request(self.op, {"kind": "page", "page": 1, "cursor": first})
            return

        items = rt.items_of(meta, payload)
        for item in items:
            yield item if isinstance(item, dict) else {"value": item}
        self.logger.info("page %s: %s items", step["page"], len(items))
        if step["page"] >= self.max_pages:
            return
        cursor = rt.next_cursor(meta, payload, step.get("cursor"), len(items))
        if cursor is None:
            return
        key = json.dumps(cursor, sort_keys=True, default=str)
        if key in self.seen_cursors:
            raise CloseSpider("cursor_loop")
        self.seen_cursors.add(key)
        yield self._request(op, {"kind": "page", "page": step["page"] + 1, "cursor": cursor})

    def closed(self, reason):
        self.logger.info("ProtoForge result counts: %s (reason=%s)", self.pf_counts, reason)
        self.crawler.stats.set_value("protoforge/counts", dict(self.pf_counts))
