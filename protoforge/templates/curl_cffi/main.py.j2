"""{{ name }} — protocol client generated by ProtoForge {{ pf_version }}.

usage:
  python main.py --list
  python main.py <operation> [--input name=value ...] [--max-pages N] [--out data/x.jsonl] [--report reports/run.json]

Credentials come from environment variables only{% if spec.session and spec.session.cookies_env %} ({{ spec.session.cookies_env }} for cookies){% endif %}.
Authorization on record: {{ spec.meta.authorization }}
"""
from __future__ import annotations

import argparse
import json
import sys
import time
from dataclasses import asdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

import api  # noqa: E402
import pf_runtime as rt  # noqa: E402


def parse_inputs(pairs: list[str]) -> dict:
    out = {}
    for p in pairs or []:
        if "=" not in p:
            raise SystemExit(f"--input expects name=value, got {p!r}")
        k, v = p.split("=", 1)
        out[k] = v
    return out


def run(op: str, inputs: dict, max_pages: int | None, out_path: Path | None, report_path: Path | None) -> int:
    ctx = api.new_context()
    client = rt.CurlClient(api.TRANSPORT, api.SESSION, ctx)
    meta = api.OPS[op]["meta"]
    key = meta.get("item_key")
    seen: set = set()
    written = pages = 0
    status = "ok"
    error = None
    started = time.time()
    fh = None
    if out_path:
        out_path.parent.mkdir(parents=True, exist_ok=True)
        fh = out_path.open("a", encoding="utf-8")
    try:
        if meta.get("items") is None and (meta.get("pagination") or {}).get("mode", "none") == "none":
            rt.run_dependencies(ctx, client, api.OPS, op, inputs)
            req = api.OPS[op]["build"](ctx, **{k: v for k, v in inputs.items() if k in meta["inputs"]})
            payload = rt.call_json(client, req, meta)
            print(json.dumps(payload, ensure_ascii=False, indent=2)[:4000])
            pages = 1
        else:
            for page, _payload, items in rt.collect(ctx, client, api.OPS, op, inputs, max_pages):
                pages = page
                for item in items:
                    if key and isinstance(item, dict) and key in item:
                        if item[key] in seen:
                            continue
                        seen.add(item[key])
                    written += 1
                    if fh:
                        fh.write(json.dumps(item, ensure_ascii=False) + "\n")
                print(f"page {page}: {len(items)} items")
    except rt.BusinessError as exc:
        status, error = "rejected", str(exc)
        print("STOP (business rejection, not retried):", exc, file=sys.stderr)
    except Exception as exc:  # report every failure class
        status, error = "error", f"{type(exc).__name__}: {exc}"
        print("STOP:", error, file=sys.stderr)
    finally:
        if fh:
            fh.close()
        client.close()
    report = {
        "op": op, "status": status, "error": error, "pages": pages, "items": written,
        "seconds": round(time.time() - started, 2),
        "attempts": [asdict(a) for a in client.attempts],
        "counts": {c: sum(1 for a in client.attempts if a.result == c)
                   for c in (rt.TRANSPORT_ERROR, rt.REJECTED, rt.ACCEPTED, rt.TARGET_OK)},
    }
    if report_path:
        report_path.parent.mkdir(parents=True, exist_ok=True)
        report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"{status}: {pages} page(s), {written} item(s)")
    return 0 if status == "ok" else 1


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("op", nargs="?", choices=list(api.OPS))
    ap.add_argument("--input", action="append", default=[], metavar="name=value")
    ap.add_argument("--max-pages", type=int)
    ap.add_argument("--out", type=Path)
    ap.add_argument("--report", type=Path)
    ap.add_argument("--list", action="store_true")
    args = ap.parse_args()
    if args.list or not args.op:
        for n, o in api.OPS.items():
            m = o["meta"]
            print(f"{n:24s} {m['method']:6s} {m['path']}  inputs={m['inputs']}  deps={m.get('depends_on', [])}")
        return 0
    return run(args.op, parse_inputs(args.input), args.max_pages, args.out, args.report)


if __name__ == "__main__":
    raise SystemExit(main())
